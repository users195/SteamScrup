<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Dark theme. Every key in this file must also exist in Light.xaml with the same
         name: the two dictionaries are swapped at runtime while the app is running. -->

    <!-- Surfaces -->
    <Color x:Key="BgWindowColor">#FF14181D</Color>
    <Color x:Key="BgPanelColor">#FF1B2028</Color>
    <Color x:Key="BgCardColor">#FF1E242D</Color>
    <Color x:Key="BgHoverColor">#FF2A323D</Color>
    <Color x:Key="BgSelectedColor">#FF23313D</Color>

    <SolidColorBrush x:Key="BgWindow" Color="{StaticResource BgWindowColor}" />
    <SolidColorBrush x:Key="BgPanel" Color="{StaticResource BgPanelColor}" />
    <SolidColorBrush x:Key="BgCard" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgHover" Color="{StaticResource BgHoverColor}" />
    <SolidColorBrush x:Key="BgSelected" Color="{StaticResource BgSelectedColor}" />
    <SolidColorBrush x:Key="BgInput" Color="#FF11151A" />

    <!-- Text -->
    <SolidColorBrush x:Key="FgPrimary" Color="#FFE8EDF2" />
    <SolidColorBrush x:Key="FgSecondary" Color="#FF9AA7B4" />
    <SolidColorBrush x:Key="FgMuted" Color="#FF6B7885" />
    <SolidColorBrush x:Key="FgOnAccent" Color="#FF0B1116" />

    <!-- Lines -->
    <SolidColorBrush x:Key="BorderSubtle" Color="#FF2C333D" />
    <SolidColorBrush x:Key="BorderStrong" Color="#FF3A434F" />

    <!-- Accent: light blue in dark mode so it stays vivid on a dark surface -->
    <SolidColorBrush x:Key="Accent" Color="#FF66C0F4" />
    <SolidColorBrush x:Key="AccentHover" Color="#FF7FCCF7" />
    <SolidColorBrush x:Key="AccentPressed" Color="#FF4FAEE6" />
    <SolidColorBrush x:Key="AccentSoft" Color="#FF1B2A38" />
    <SolidColorBrush x:Key="AccentMuted" Color="#FF2A4256" />

    <!-- Status -->
    <SolidColorBrush x:Key="DangerBg" Color="#FF3A2124" />
    <SolidColorBrush x:Key="DangerFg" Color="#FFFF8A8A" />
    <SolidColorBrush x:Key="DangerBorder" Color="#FF6B3238" />
    <SolidColorBrush x:Key="WarnBg" Color="#FF3A3320" />
    <SolidColorBrush x:Key="WarnFg" Color="#FFE8C36A" />
    <SolidColorBrush x:Key="OkBg" Color="#FF1E3327" />
    <SolidColorBrush x:Key="OkFg" Color="#FF7BD99B" />
    <SolidColorBrush x:Key="InfoBg" Color="#FF1E2A38" />
    <SolidColorBrush x:Key="InfoFg" Color="#FF8FC7EE" />

    <!-- Card elevation. Dark mode uses a barely visible shadow plus a lighter card
         surface, because a strong shadow on a dark background reads as a smear. -->
    <sys:Double x:Key="CardShadowOpacity">0.34</sys:Double>
    <sys:Double x:Key="CardShadowBlur">14</sys:Double>
    <sys:Double x:Key="CardShadowDepth">3</sys:Double>
    <Color x:Key="CardShadowColor">#FF000000</Color>

    <SolidColorBrush x:Key="CardShadowBrush" Color="#59000000" />

</ResourceDictionary>
