<Window x:Class="SteamScrup.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SteamScrup.UI"
        Title="{Binding [app.shortTitle]}"
        Width="1180" Height="780"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgWindow}"
        Foreground="{DynamicResource FgPrimary}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ui:ConfidenceLabelConverter x:Key="ConfLabel" />
        <ui:ConfidenceBackgroundConverter x:Key="ConfBg" />
        <ui:ConfidenceForegroundConverter x:Key="ConfFg" />
        <ui:BooleanToVisibilityConverter x:Key="BoolVis" />
        <!-- Dedicated class rather than a ConverterParameter: parameters were arriving as
             null, which made the inverted case silently behave like the normal one. -->
        <ui:InvertedBooleanToVisibilityConverter x:Key="BoolVisInv" />

        <!-- ===================== candidate card ===================== -->
        <DataTemplate x:Key="CandidateCard" DataType="{x:Type ui:ScanRowViewModel}">
            <Border x:Name="CardRoot" CornerRadius="10" Padding="12,10"
                    Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- selection -->
                    <CheckBox Grid.Column="0" Style="{StaticResource CleanCheck}"
                              VerticalAlignment="Center" Margin="0,0,12,0"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              IsEnabled="{Binding CanSelect}"
                              Checked="OnRowSelectionChanged"
                              Unchecked="OnRowSelectionChanged" />

                    <!-- category icon block -->
                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="9"
                            Background="{DynamicResource AccentSoft}"
                            VerticalAlignment="Top" Margin="0,1,12,0">
                        <TextBlock Style="{StaticResource Icon}"
                                   Text="{Binding Glyph}"
                                   Foreground="{Binding CategoryBrush}" />
                    </Border>

                    <!-- description -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource H2}"
                                       VerticalAlignment="Center" />
                            <!-- Game-name bubble. The title above stays the folder name or
                                 appid; the resolved name appears here instead of replacing it. -->
                            <Border CornerRadius="5" Padding="7,2" Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentSoft}"
                                    Visibility="{Binding HasGameNameBubble, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding GameNameBubble}" FontSize="11"
                                           Foreground="{DynamicResource Accent}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="320" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Path}" Style="{StaticResource PathText}"
                                   Margin="0,2,0,0" ToolTip="{Binding Path}" />
                        <TextBlock Text="{Binding Reason}" Style="{StaticResource Muted}"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- metadata -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Top" Margin="12,0,0,0"
                                HorizontalAlignment="Right">
                        <Border CornerRadius="5" Padding="8,3" HorizontalAlignment="Right"
                                Background="{Binding Confidence, Converter={StaticResource ConfBg}}">
                            <TextBlock Text="{Binding Confidence, Converter={StaticResource ConfLabel}}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{Binding Confidence, Converter={StaticResource ConfFg}}" />
                        </Border>
                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource H2}"
                                   HorizontalAlignment="Right" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource Muted}"
                                   HorizontalAlignment="Right" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding FileCountText}" Style="{StaticResource Muted}"
                                   HorizontalAlignment="Right" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsProtected}" Value="True">
                    <Setter TargetName="CardRoot" Property="Opacity" Value="0.62" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="CardRoot" Property="Background" Value="{DynamicResource BgSelected}" />
                    <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================= top status bar ======================= -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid Margin="18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- identity + steam state -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10"
                            Background="{DynamicResource AccentSoft}">
                        <Image Source="/Assets/app-preview.png" Margin="4" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [app.shortTitle]}" Style="{StaticResource H1}" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center"
                                    Background="{Binding SteamStateBrush}" />
                            <TextBlock Text="{Binding SteamStateText}" Style="{StaticResource Muted}"
                                       Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- progress + status -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="28,0,20,0">
                    <Grid Height="6" ClipToBounds="True" Background="{DynamicResource BgHover}"
                          Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding ScanProgressColumn}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource Accent}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                                   Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding ProgressDetailText}"
                                   Style="{StaticResource Caption}" Margin="10,0,0,0" />
                    </Grid>
                </StackPanel>

                <!-- actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BaseButton}" Margin="0,0,8,0"
                            Command="{Binding CancelScanCommand}"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconSmall}" Text="{Binding GlyphStop}" />
                            <TextBlock Text="{Binding [tb.stop]}" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SoftAccentButton}"
                            Command="{Binding ScanCommand}"
                            IsEnabled="{Binding CanScan}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconSmall}" Text="{Binding GlyphScan}" />
                            <TextBlock Text="{Binding [tb.scan]}" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ====== steam warning: only for the categories Steam actually holds ====== -->
        <Border Grid.Row="1" Margin="18,10,18,0" CornerRadius="8" Padding="12,9"
                Background="{DynamicResource WarnBg}"
                Visibility="{Binding ShowSteamBanner, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconSmall}" Text="{Binding GlyphWarning}"
                               Foreground="{DynamicResource WarnFg}" />
                    <TextBlock Text="{Binding SteamBlockedBannerText}" Margin="9,0,0,0"
                               FontSize="12" Foreground="{DynamicResource WarnFg}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding SteamBlockedCategoriesText}" Margin="25,3,0,0"
                           FontSize="11" Foreground="{DynamicResource WarnFg}"
                           Opacity="0.85" TextWrapping="Wrap"
                           Visibility="{Binding IsCleanBlockedBySteam, Converter={StaticResource BoolVis}}" />
            </StackPanel>
        </Border>

        <!-- ============================= body ============================= -->
        <Grid Grid.Row="2" Margin="18,12,18,0">
            <Grid.ColumnDefinitions>
                <!-- Width is user-adjustable: some category titles are long enough to be
                     clipped at any fixed value. Bound to the view model so the choice is
                     remembered between runs. -->
                <ColumnDefinition x:Name="SidebarColumn" Width="{Binding SidebarWidth}" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ========== sidebar resize handle ========== -->
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1"
                          Width="6" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="False"
                          Cursor="SizeWE"
                          ToolTip="{Binding [set.sidebarWidthHint]}"
                          DragCompleted="OnSidebarSplitterDragCompleted"
                          MouseDoubleClick="OnSidebarSplitterDoubleClick" />

            <!-- ========== sidebar ========== -->
            <Border Grid.Column="0" CornerRadius="10"
                    Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                <Grid Margin="8,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource NavItem}"
                                                 GroupName="nav"
                                                 Checked="OnCategoryChecked"
                                                 Tag="{Binding}"
                                                 Visibility="{Binding IsVisible, Converter={StaticResource BoolVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource IconSmall}"
                                                       Text="{Binding Glyph}" />
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                                            <Border Grid.Column="2" CornerRadius="9" Padding="7,1"
                                                    Background="{DynamicResource BgHover}"
                                                    Visibility="{Binding HasItems, Converter={StaticResource BoolVis}}">
                                                <!-- Shows "selected/total" once anything in the
                                                     category is ticked, otherwise just the total. -->
                                                <TextBlock Text="{Binding CountText}" FontSize="10.5"
                                                           Foreground="{DynamicResource FgMuted}" />
                                            </Border>
                                        </Grid>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="10,10,10,2">
                        <TextBlock Text="{Binding [sum.libraryList]}" Style="{StaticResource Muted}" />
                        <ItemsControl ItemsSource="{Binding Libraries}" Margin="0,5,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource PathText}"
                                               FontSize="10.5" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========== content ========== -->
            <Grid Grid.Column="2" Margin="12,0,0,0">

                <!-- ====================== summary view ====================== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsSummarySelected, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <!-- metric cards -->
                        <UniformGrid Rows="1" Margin="0,0,0,10">
                            <ContentControl Style="{StaticResource ElevatedCard}" Margin="0,0,6,0">
                                <StackPanel Margin="16,14">
                                    <TextBlock Text="{Binding [sum.steamPath]}" Style="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding SteamRootText}" Style="{StaticResource H2}"
                                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SteamRootText}" />
                                </StackPanel>
                            </ContentControl>
                            <ContentControl Style="{StaticResource ElevatedCard}" Margin="6,0">
                                <StackPanel Margin="16,14">
                                    <TextBlock Text="{Binding [sum.games]}" Style="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding GameCount}" Style="{StaticResource H1}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </ContentControl>
                            <ContentControl Style="{StaticResource ElevatedCard}" Margin="6,0">
                                <StackPanel Margin="16,14">
                                    <TextBlock Text="{Binding [sum.candidates]}" Style="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding CandidateCount}" Style="{StaticResource H1}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </ContentControl>
                            <ContentControl Style="{StaticResource ElevatedCard}" Margin="6,0,0,0">
                                <StackPanel Margin="16,14">
                                    <TextBlock Text="{Binding [sum.selectedSize]}" Style="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding SelectedSizeText}" Style="{StaticResource H1}"
                                               Margin="0,3,0,0" Foreground="{DynamicResource Accent}" />
                                </StackPanel>
                            </ContentControl>
                        </UniformGrid>

                        <!-- charts -->
                        <ContentControl Style="{StaticResource ElevatedCard}">
                            <StackPanel Margin="18,16">
                                <TextBlock Text="{Binding [sum.breakdown]}" Style="{StaticResource H2}" />
                                <TextBlock Text="{Binding [sum.breakdownHint]}" Style="{StaticResource Muted}"
                                           Margin="0,4,0,0" />

                                <TextBlock Text="{Binding [sum.noData]}" Style="{StaticResource Caption}"
                                           Margin="0,18,0,10" TextWrapping="Wrap"
                                           Visibility="{Binding HasChartData, Converter={StaticResource BoolVisInv}}" />

                                <Grid Margin="0,16,0,0"
                                      Visibility="{Binding HasChartData, Converter={StaticResource BoolVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- pie: one Path per category wedge -->
                                    <ItemsControl Grid.Column="0" Width="196" Height="196"
                                                  VerticalAlignment="Top" Margin="0,0,28,0"
                                                  ItemsSource="{Binding PieSlices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Path Data="{Binding Geometry}"
                                                      Fill="{Binding Fill}"
                                                      Stroke="{DynamicResource BgCard}"
                                                      StrokeThickness="1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- insight + legend + bars -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding InsightText}" Style="{StaticResource Caption}"
                                                   Margin="0,0,0,16" TextWrapping="Wrap" />

                                        <ItemsControl ItemsSource="{Binding CategoryStats}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Row="0" Grid.Column="0" Width="10" Height="10"
                                                                CornerRadius="3" VerticalAlignment="Center"
                                                                Background="{Binding Fill}" />
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Label}"
                                                                   Style="{StaticResource Caption}"
                                                                   Margin="9,0,10,0" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SizeText}"
                                                                   Style="{StaticResource Caption}"
                                                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding PercentText}"
                                                                   Style="{StaticResource Muted}"
                                                                   VerticalAlignment="Center" MinWidth="44"
                                                                   TextAlignment="Right" />

                                                        <Grid Grid.Row="1" Grid.ColumnSpan="4" Height="3"
                                                              Margin="0,5,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding BarWidth}" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" CornerRadius="2"
                                                                    Background="{Binding Fill}" Opacity="0.85" />
                                                        </Grid>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ContentControl>

                        <TextBlock Text="{Binding [sum.noSteamHint]}" Style="{StaticResource Caption}"
                                   Margin="2,10,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding ShowNoSteamHint, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================= list view ======================= -->
                <Grid Visibility="{Binding IsListVisible, Converter={StaticResource BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- toolbar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Style="{StaticResource BaseButton}" Margin="0,0,6,0"
                                    Command="{Binding SelectAllCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconSmall}" Text="{Binding GlyphSelectAll}" />
                                    <TextBlock Text="{Binding [tb.selectAll]}" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BaseButton}" Margin="0,0,6,0"
                                    Command="{Binding SelectNoneCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconSmall}" Text="{Binding GlyphSelectNone}" />
                                    <TextBlock Text="{Binding [tb.selectNone]}" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BaseButton}"
                                    Command="{Binding SelectSafeCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconSmall}" Text="{Binding GlyphSafeOnly}" />
                                    <TextBlock Text="{Binding [tb.selectSafe]}" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                            <!-- Unticks the items in every category. Kept alongside the footer's
                                 "clear all selections" because this one lives with the other
                                 per-list actions and is the one reached while scanning the list. -->
                            <Button Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                    Command="{Binding ClearSelectionCommand}"
                                    ToolTip="{Binding [tb.clearSelectionHint]}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconSmall}" Text="{Binding GlyphClearSelection}" />
                                    <TextBlock Text="{Binding [tb.clearSelection]}" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- search with an in-field placeholder -->
                            <Grid Width="250" Margin="0,0,10,0">
                                <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         GotKeyboardFocus="OnSearchGotFocus"
                                         LostKeyboardFocus="OnSearchLostFocus" />
                                <TextBlock Text="{Binding [msg.searchHint]}"
                                           Style="{StaticResource Muted}"
                                           Margin="11,0,10,0" IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding ShowSearchHint, Converter={StaticResource BoolVis}}" />
                            </Grid>
                            <TextBlock Text="{Binding VisibleCountText}" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- card list -->
                    <ListBox Grid.Row="1" x:Name="RowList"
                             Style="{StaticResource ScanList}"
                             ItemsSource="{Binding Rows}"
                             ItemTemplate="{StaticResource CandidateCard}">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding [tb.openFolder]}" Click="OnOpenLocation" />
                                <MenuItem Header="{Binding [msg.copyPath]}" Click="OnCopyPath" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <!-- empty state: one place only, no duplicated status text -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolVis}}">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding GlyphInfo}"
                                   Foreground="{DynamicResource FgMuted}" FontSize="28" />
                        <TextBlock Text="{Binding EmptyStateText}" Style="{StaticResource Caption}"
                                   Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- ====================== settings view ====================== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsSettingsSelected, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding [set.title]}" Style="{StaticResource H1}" Margin="2,0,0,12" />

                        <!-- appearance -->
                        <ContentControl Style="{StaticResource ElevatedCard}">
                            <StackPanel Margin="18,16">
                                <TextBlock Text="{Binding [set.appearance]}" Style="{StaticResource H2}" />

                                <TextBlock Text="{Binding [set.theme]}" Style="{StaticResource Muted}" Margin="0,14,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <RadioButton Style="{StaticResource OptionRadio}" GroupName="theme"
                                                 Content="{Binding [set.theme.system]}" Tag="System"
                                                 Checked="OnThemeChecked" />
                                    <RadioButton Style="{StaticResource OptionRadio}" GroupName="theme"
                                                 Content="{Binding [set.theme.light]}" Tag="Light"
                                                 Margin="20,4,0,0" Checked="OnThemeChecked" />
                                    <RadioButton Style="{StaticResource OptionRadio}" GroupName="theme"
                                                 Content="{Binding [set.theme.dark]}" Tag="Dark"
                                                 Margin="20,4,0,0" Checked="OnThemeChecked" />
                                </StackPanel>

                                <TextBlock Text="{Binding [set.language]}" Style="{StaticResource Muted}" Margin="0,16,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <RadioButton Style="{StaticResource OptionRadio}" GroupName="lang"
                                                 Content="{Binding [set.language.system]}" Tag="system"
                                                 Checked="OnLanguageChecked" />
                                    <RadioButton Style="{StaticResource OptionRadio}" GroupName="lang"
                                                 Content="{Binding [set.language.zh]}" Tag="zh-CN"
                                                 Margin="20,4,0,0" Checked="OnLanguageChecked" />
                                    <RadioButton Style="{StaticResource OptionRadio}" GroupName="lang"
                                                 Content="{Binding [set.language.en]}" Tag="en"
                                                 Margin="20,4,0,0" Checked="OnLanguageChecked" />
                                </StackPanel>
                            </StackPanel>
                        </ContentControl>

                        <!-- paths -->
                        <ContentControl Style="{StaticResource ElevatedCard}">
                            <StackPanel Margin="18,16">
                                <TextBlock Text="{Binding [set.paths]}" Style="{StaticResource H2}" />

                                <TextBlock Text="{Binding [set.steamPath]}" Style="{StaticResource Muted}" Margin="0,14,0,0" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource InputBox}"
                                             Text="{Binding SteamRootOverride, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="{Binding [set.steamPath.browse]}"
                                            Margin="8,0,0,0" Style="{StaticResource BaseButton}"
                                            Click="OnBrowseSteamRoot" />
                                </Grid>

                                <TextBlock Text="{Binding [log.directory]}" Style="{StaticResource Muted}" Margin="0,14,0,0" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource InputBox}"
                                             Text="{Binding LogDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="{Binding [log.browse]}" Margin="8,0,0,0"
                                            Style="{StaticResource BaseButton}" Click="OnBrowseLogDirectory" />
                                    <Button Grid.Column="2" Content="{Binding [log.open]}" Margin="8,0,0,0"
                                            Style="{StaticResource BaseButton}" Click="OnOpenLogDirectory" />
                                </Grid>

                                <TextBlock Text="{Binding [set.dataLocation]}" Style="{StaticResource Muted}" Margin="0,14,0,0" />
                                <TextBlock Text="{Binding DataLocationText}" Style="{StaticResource PathText}"
                                           Margin="0,5,0,0" TextWrapping="Wrap" />

                                <!-- Names for appid-titled candidates are fetched from the
                                     Steam public endpoint once and cached locally. -->
                                <TextBlock Text="{Binding NameResolutionText}" Style="{StaticResource Muted}"
                                           Margin="0,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============================= footer ============================= -->
        <Border Grid.Row="3" Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0">
            <Grid Margin="18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Selects safe candidates across every category, not just the visible one. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource SoftAccentButton}"
                            Command="{Binding SelectAllSafeCommand}"
                            ToolTip="{Binding [tb.selectSafeHint]}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconSmall}" Text="{Binding GlyphSafeOnly}" />
                            <TextBlock Text="{Binding [tb.selectSafeAll]}" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Unticks every candidate everywhere, including items hidden by the
                         current category filter or the search box. -->
                    <Button Style="{StaticResource BaseButton}" Margin="8,0,0,0"
                            Command="{Binding ClearSelectionCommand}"
                            ToolTip="{Binding [tb.clearAllHint]}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconSmall}" Text="{Binding GlyphClearSelection}" />
                            <TextBlock Text="{Binding [tb.clearAll]}" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="14,0">
                    <TextBlock Text="{Binding SelectionSummaryText}"
                               Style="{StaticResource Caption}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Fine-grained control: these categories are not held by Steam, so a
                         running client does not block them. -->
                    <Border CornerRadius="5" Padding="7,2" Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource OkBg}"
                            Visibility="{Binding ShowSteamNotRequiredHint, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding [steam.notRequiredHint]}" FontSize="11"
                                   Foreground="{DynamicResource OkFg}" />
                    </Border>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                        IsEnabled="{Binding CanClean}"
                        Click="OnCleanClicked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconSmall}" Text="{Binding GlyphClean}" />
                        <TextBlock Text="{Binding CleanButtonText}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>


