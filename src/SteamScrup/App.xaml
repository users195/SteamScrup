<Application x:Class="SteamScrup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is replaced at runtime by Light.xaml or Dark.xaml.
                     App.ApplyTheme() depends on that position, so keep it first. -->
                <ResourceDictionary Source="UI/Themes/Dark.xaml" />
                <ResourceDictionary Source="UI/Styles.xaml" />
                <ResourceDictionary Source="UI/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
