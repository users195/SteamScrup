<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Offline-first NuGet configuration.
    The self-contained runtime packs are vendored into tools\runtimepacks, so a
    portable build needs no network at all. The public source stays declared but is
    only reached when a package is genuinely missing from the local folder.
  -->
  <packageSources>
    <clear />
    <add key="local-runtimepacks" value="C:\Users\19514\Desktop\SteamScrup\tools\runtimepacks" />
  </packageSources>
  <config>
    <add key="globalPackagesFolder" value="C:\Users\19514\Desktop\SteamScrup\tools\nuget" />
  </config>
</configuration>
