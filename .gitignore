# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
bin/
obj/
dist/
*.user
*.suo
.vs/

# ---------------------------------------------------------------------------
# Portable SDK and package caches used for offline builds.
#
# tools/dotnet    ~770 MB portable .NET SDK   (see README: build prerequisites)
# tools/runtimepacks ~89 MB vendored runtime packages
# tools/nuget     ~310 MB global package cache
# tools/clihome, tools/appdata  toolchain state
#
# None of this is source. It is excluded so the repository stays around 1 MB.
# ---------------------------------------------------------------------------
tools/dotnet/
tools/nuget/
tools/runtimepacks/
tools/clihome/
tools/appdata/

# ---------------------------------------------------------------------------
# Runtime state written next to the executable by the portable build
# ---------------------------------------------------------------------------
logs/
settings.json
names.json
*.log

