# Local scratch: backups, probe output, generated reports
# ---------------------------------------------------------------------------
backup/
_excluded-backup/
SteamScrup-repo/
probe-out.txt
font-probe.txt
selftest-report.txt
smoke-report.txt
binding-report.txt
icons-*.png
